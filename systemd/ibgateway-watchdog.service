# IB Gateway watchdog — one PASSIVE supervision cycle per activation.
#
# It never handles credentials, never places orders and never bypasses 2FA.
#
# ACCOUNT-SAFETY GATE: no unattended START/RESTART/RELOGIN may proceed unless
# a complete read-only snapshot proves the account CLEAN. Every state that
# could trigger a restart (process down, API down, login incomplete, 2FA
# pending) is definitionally UNKNOWN, because a dead API cannot answer a
# broker query — so in practice this unit SUPERVISES AND ALERTS and does not
# restart the Gateway. Recovery is an owner-authorized action under
# docs/runbooks/CHAOS_RECOVERY_DRILLS.md.
#
# This unit is NOT a second Gateway manager: it drives exactly one service,
# ibgateway-ibc.service, and only through the gate above.
#
# Distinct exit codes carry severity to the journal.

[Unit]
Description=IB Gateway (Paper) watchdog cycle
After=network-online.target
Wants=network-online.target
# /run/ibgateway is owned by tmpfiles.d, NOT by this unit. See the
# RuntimeDirectory note below; this ordering makes its existence deterministic.
After=systemd-tmpfiles-setup.service

[Service]
Type=oneshot
User=opc
Group=opc
#
# CANONICAL RUNTIME. Absolute interpreter, absolute script, both inside the
# reviewed repository. DO NOT change any of the three lines below to
# /usr/bin/env, to the system python, or to a copy under /opt.
#
# The host previously ran `/usr/bin/env python3 /opt/trading/scripts/...`,
# which is wrong twice over: /opt held a STALE copy that had drifted from the
# reviewed source, and the system python cannot import trading_broker_ibkr at
# all, so the deep probe could never have worked. PATH-resolved interpreters
# also mean the timer runs whatever python happens to be first today.
WorkingDirectory=/home/opc/projects/TradingSystem
ExecStart=/home/opc/projects/TradingSystem/.venv/bin/python \
  /home/opc/projects/TradingSystem/scripts/ib_gateway_watchdog.py \
  --host 127.0.0.1 --port 4002 \
  --log-path /home/opc/ibc/logs/ibc.log \
  --state-file /run/ibgateway/watchdog-state.json \
  --lock-file /run/ibgateway/watchdog.lock \
  --reconciliation-marker /run/ibgateway/order-lifecycle.active \
  --unit ibgateway-ibc.service
# Waiting/refusal states are not failures: 20/21/22 wait, and 42/43 are the
# account-safety gate REFUSING an action, which is correct behaviour and must
# not flap the unit. Only genuine fail-closed codes (30/40/41) mark it failed.
SuccessExitStatus=0 10 11 12 20 21 22 42 43
#
# RuntimeDirectory= IS DELIBERATELY ABSENT. DO NOT ADD IT.
#
# This is Type=oneshot: the unit goes inactive the moment the cycle ends. With
# RuntimeDirectory=ibgateway and the default RuntimeDirectoryPreserve=no,
# systemd would DELETE /run/ibgateway on every single cycle — destroying
#   /run/ibgateway/order-lifecycle.active  (the inhibit marker)
#   /run/ibgateway/watchdog-state.json     (the restart budget)
#   /run/ibgateway/watchdog.lock           (the concurrency lock)
# A supervisor that erases its own inhibit marker every minute, and resets the
# budget that rate-limits it, is strictly more dangerous than no supervisor.
#
# /run/ibgateway has exactly ONE owner: /etc/tmpfiles.d/ibgateway.conf. It is
# created at boot by systemd-tmpfiles-setup.service, 0700 opc:opc, and no unit
# stop removes it — so it exists while the Gateway is DOWN, which is precisely
# when this watchdog needs it.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# No leading '-': if tmpfiles has not created /run/ibgateway, this unit must
# FAIL rather than run without its budget, lock and lifecycle marker.
ReadWritePaths=/run/ibgateway
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
# The watchdog must reach the LOCAL API socket (127.0.0.1:4002) for its
# read-only probe, so local IP access stays available on purpose.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
