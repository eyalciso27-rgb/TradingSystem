# Runs the IB Gateway watchdog cycle shortly after boot and then periodically.
#
# This timer drives PASSIVE supervision. The watchdog is lock-guarded and
# rate-limited, and every unattended process action is additionally gated on a
# complete read-only proof that the account is CLEAN — so no firing frequency,
# overlap or budget can produce a blind restart.

[Unit]
Description=Periodic IB Gateway (Paper) watchdog

[Timer]
OnBootSec=90s
OnUnitActiveSec=60s
AccuracySec=5s
Unit=ibgateway-watchdog.service

[Install]
WantedBy=timers.target
