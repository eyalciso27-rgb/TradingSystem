# IB Gateway (Paper) via IBC — THE ONE CANONICAL GATEWAY SERVICE.
#
# There is exactly one Gateway service in this repository and on the host:
# `ibgateway-ibc.service`. A second unit, a user-level copy, a cron entry or
# a supervisor wrapper would be a competing restart manager: two managers can
# race, double-launch the Gateway and produce two API clients on one account.
# Do not add one.
#
# Credentials are NOT here: they live only in the IBC config file (chmod 600),
# read by IBC itself. No credential appears in this unit, in the command line
# or in a visible Environment= entry.
#
# `Restart=no` is deliberate. Automatic restart is exactly the blind recovery
# the account-safety gate exists to prevent: systemd cannot know whether an
# order is working. Recovery is an owner-authorized action under
# docs/runbooks/CHAOS_RECOVERY_DRILLS.md; the unattended watchdog only
# supervises and alerts.
#
# Install: copy to /etc/systemd/system/, then `systemctl daemon-reload`.
# Do NOT enable/start until the owner has completed secure IBC setup and is
# ready to approve the IBKR Mobile 2FA prompt.

[Unit]
Description=IB Gateway (Paper) via IBC
After=network-online.target
Wants=network-online.target
# /run/ibgateway is owned by tmpfiles.d, NOT by this unit (see below).
After=systemd-tmpfiles-setup.service

[Service]
Type=simple
User=opc
Group=opc
# Non-secret paths only. The IB login id/password are read by IBC from
# IBC_INI (chmod 600), never from here.
Environment=IBC_PATH=/opt/ibc
Environment=IBC_INI=/home/opc/.config/ibc/config.ini
Environment=TWS_MAJOR_VRSN=1048
Environment=IBC_LOG_PATH=/home/opc/ibc/logs
ExecStart=/usr/bin/env bash /opt/trading/scripts/start_ibc_gateway.sh
# NO automatic restart: recovery is owner-authorized, never blind.
Restart=no
#
# RuntimeDirectory= IS DELIBERATELY ABSENT. DO NOT ADD IT.
#
# /run/ibgateway holds the lock, the watchdog restart budget and the
# order-lifecycle marker. Those must survive this service being STOPPED — the
# whole point of the marker is to inhibit action while the Gateway is down, and
# RuntimeDirectory is torn down on stop. It also must exist BEFORE this service
# has ever started, which RuntimeDirectory cannot provide.
#
# Exactly one owner: /etc/tmpfiles.d/ibgateway.conf (0700 opc:opc, created at
# boot). Declaring RuntimeDirectory here as well would give the directory two
# independent lifetimes and let either unit's stop delete the other's state.
# Hardening. NOTE: the Gateway must keep binding its LOCAL API socket
# (127.0.0.1:4002) and reaching IBKR outbound, so no IP/socket namespace
# restriction is applied here — that would break the very API the
# read-only probe depends on.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
#
# ProtectHome=read-only STAYS. It is not weakened here and must not be: the
# rest of /home/opc — the repository, the SSH keys, the owner's files — stays
# unwritable to the Gateway. ReadWritePaths= re-opens ONLY the four trees the
# Gateway genuinely writes, and is applied after ProtectHome, so this is a
# narrow exception rather than a relaxation.
#
# /home/opc/Jts is the IB Gateway INSTALLATION AND ITS SETTINGS TREE. IBC's
# ibcstart.sh uses ~/Jts as the TWS/Gateway path and writes there during
# startup (the Gateway startup/settings/runtime files), and the Java the
# service executes lives under it. Without this entry the Gateway's own
# working tree is read-only: the service starts, the launch fails, and the
# unit goes straight to `inactive (dead)` with `Deactivated successfully.` —
# a clean-looking exit for a sandbox conflict. Do not remove this path
# without moving the Gateway installation somewhere already writable.
ReadWritePaths=/home/opc/Jts /home/opc/ibc /home/opc/.config/ibc /run/ibgateway
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
